<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="appsettings.json" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Extensions.HttpClient" Version="4.0.4141" />
        <PackageReference Include="Soenneker.Utils.Test" Version="4.0.342" />
        <PackageReference Include="Soenneker.Tests.HostedUnit" Version="4.0.338" />
        <PackageReference Include="TUnit" Version="1.76.28" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.GitHub.Client.Http\Soenneker.GitHub.Client.Http.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    </ItemGroup>
</Project>
